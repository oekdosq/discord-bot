# Discord bot — token & konfigurasi
# 1. Buat app di https://discord.com/developers/applications
# 2. Bot -> Reset Token -> salin ke DISCORD_TOKEN
# 3. OAuth2 -> Client ID -> salin ke CLIENT_ID

DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_application_client_id

# (opsional) register command hanya ke satu server — lebih cepat saat pengerjaan
# GUILD_ID=

# (opsional) URL web app ai-trading untuk fitur /signal.
# Di VM Oracle biarkan default (localhost) — kedua service di mesin yang sama.
# TRADING_API_URL=http://localhost:8000