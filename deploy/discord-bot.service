[Unit]
Description=Discord bot (AI Trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/bots/discord-bot
EnvironmentFile=/opt/bots/discord-bot/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target